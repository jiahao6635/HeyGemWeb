# Required: define at least one account for Gradio server-side authentication.
# Each username also becomes that account's media-storage namespace.
USER_1_NAME=admin
USER_1_PASSWORD=replace-with-a-long-random-password

# HeyGem-compatible backend services. Deploy these separately.
HEYGEM_TTS_URL=http://localhost:18180
HEYGEM_VIDEO_URL=http://localhost:8383

# Local data and server settings.
HEYGEM_BASE_DIR=./heygem_data
HEYGEM_HOST=0.0.0.0
HEYGEM_PORT=2531
HEYGEM_LOG_LEVEL=INFO
HEYGEM_MAX_UPLOAD_MB=500
